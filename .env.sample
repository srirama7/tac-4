# API Keys for LLM providers

# Gemini API Configuration
# OPTIONAL for ADW (uses Claude Code CLI instead)
# REQUIRED for SQL operations and natural language query generation
# Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# (Optional) Gemini Model Selection for SQL operations
# Options: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-pro, gemini-1.5-flash
# Default: gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# GitHub Configuration (Optional)
# Use this if you want ADW to use a different GitHub account than your default 'gh auth' login
GITHUB_PAT=

# Claude Code Configuration
# ADW now uses Claude Code CLI for planning and implementation
# Ensure Claude Code CLI is installed: https://docs.claude.com/en/docs/claude-code/setup
# Configure your preferred Claude model in .claude/settings.json